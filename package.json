{
   "name": "pwhl-api",
   "version": "0.1.0",
   "description": "A modern PWHL stats API wrapper written in TypeScript.",
   "main": "lib/index.cjs",
   "module": "lib/index.js",
   "types": "lib/index.d.ts",
   "type": "module",
   "exports": {
      ".": {
         "types": "./lib/index.d.ts",
         "require": "./lib/index.cjs",
         "import": "./lib/index.js"
      }
   },
   "files": [
      "lib",
      "README.md",
      "LICENSE"
   ],
   "scripts": {
      "build": "bunx tsup",
      "dev": "bunx tsup --watch",
      "typecheck": "bunx tsc --noEmit",
      "lint": "bunx biome check .",
      "format": "bunx biome check --write .",
      "test": "bun test",
      "test:watch": "bun test --watch",
      "prepublishOnly": "bun run build"
   },
   "keywords": [
      "pwhl",
      "hockeytech",
      "leaguestat",
      "api",
      "stats",
      "hockey",
      "womens-hockey",
      "typescript"
   ],
   "author": "jbru",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/spiflicate/pwhl-api.git"
   },
   "bugs": {
      "url": "https://github.com/spiflicate/pwhl-api/issues"
   },
   "homepage": "https://github.com/spiflicate/pwhl-api#readme",
   "devDependencies": {
      "@biomejs/biome": "2.5.4",
      "@types/bun": "^1.3.14",
      "tsup": "^8.5.1",
      "typescript": "^5.9"
   },
   "dependencies": {
      "arktype": "^2.2.3"
   }
}
